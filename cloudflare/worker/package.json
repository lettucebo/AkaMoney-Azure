{
  "name": "akamoney-api",
  "version": "1.0.0",
  "description": "AkaMoney Short URL Service - Cloudflare Workers API",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:migrate": "wrangler d1 execute akamoney-clicks --local --file=../migrations/0001_create_clickinfo.sql",
    "db:migrate:remote": "wrangler d1 execute akamoney-clicks --file=../migrations/0001_create_clickinfo.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.91.0"
  }
}
