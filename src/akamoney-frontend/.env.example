# AkaMoney Frontend Environment Example for Microsoft Entra ID
# 請依照實際 Azure Entra ID 註冊資訊填寫

# API URL - Local development uses proxy, production uses Workers URL
VUE_APP_API_URL=http://localhost:8787
# For production: VUE_APP_API_URL=https://akamoney-api.your-subdomain.workers.dev

VUE_APP_CLIENT_ID=your-entra-client-id
VUE_APP_TENANT_ID=your-entra-tenant-id
VUE_APP_API_CLIENT_ID=your-api-app-client-id
# VUE_APP_REDIRECT_URL=（可選，預設為 window.location.origin）
